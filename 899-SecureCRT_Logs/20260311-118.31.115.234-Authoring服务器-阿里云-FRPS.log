104942.531: [10:49:42]                server {
104942.614: [10:49:42]                # 设置监听端口及协议，443为https的默认端口，建议使用443
104943.082: [10:49:43]                listen 443 ssl;
104943.321: [10:49:43]                client_max_body_size 1024M;
104943.502: [10:49:43]                client_body_buffer_size 128k;
104943.667: [10:49:43]                # 以下ssl文件夹与nginx.conf平级
104943.862: [10:49:43]                # 设置证书crt文件路径，正式部署时将server.crt替换为客户的正式证书
104944.052: [10:49:44]                ssl_certificate     cert/tiangongqs.net.pem;
104944.347: [10:49:44]                # 设置证书key文件路径，正式部署时将server.key替换为客户的正式证书
104944.431: [10:49:44]                ssl_certificate_key cert/tiangongqs.net.key;
