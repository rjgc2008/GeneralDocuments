104930.362: [10:49:30]         upstream seeyon_v5_cluster{
104930.860: [10:49:30]                            server 58.211.207.202:8071 max_fails=300 fail_timeout=30s;
104930.945: [10:49:30]        }
104931.028: [10:49:31]        server {
104931.119: [10:49:31]               listen 80;
104931.240: [10:49:31]               server_name www.tiangongqs.net;
104931.285: [10:49:31]               client_max_body_size 1024M;
104931.362: [10:49:31]               client_body_buffer_size 128k;
104931.447: [10:49:31]               #return 301 https://www.tiangongqs.net;
104931.530: [10:49:31]               location / {
104931.620: [10:49:31]                          root html;
104931.759: [10:49:31]                          index index.html;
104931.780: [10:49:31]                          proxy_pass http://58.211.207.202:8071;
104931.863: [10:49:31]                          proxy_set_header Host $http_host;
104941.612: [10:49:41]                          proxy_set_header X-Real-IP $remote_addr;
104942.112: [10:49:42]                          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
104942.251: [10:49:42]                          proxy_set_header REMOTE-HOST $remote_addr;
104942.291: [10:49:42]               }
104942.362: [10:49:42]        }
