160442.570: [16:04:42]root@anncara-computer:/DATA/xiaomi_camera_videos# vi /DATA/xiaomi_camera_videos/rsync.sh
160442.657: [16:04:42]#!/bin/bash
160442.658: [16:04:42]# 功能：将 A 主机 /data/project/ 单向同步到 B 主机
160442.658: [16:04:42]# ============================================
160442.658: [16:04:42]
160442.658: [16:04:42]SRC_DIR="/DATA/xiaomi_camera_videos/"
160442.658: [16:04:42]DEST_USER="root"
160442.658: [16:04:42]DEST_HOST="10.253.0.2"
160442.658: [16:04:42]DEST_DIR="/DATA/Media/XTV-BACKUP/xiaomi_camera_videos/"
160442.658: [16:04:42]LOG_FILE="/var/log/rsync_project.log"
160442.659: [16:04:42]DATE=$(date '+%Y-%m-%d %H:%M:%S')
160442.659: [16:04:42]
160442.659: [16:04:42]echo "[$DATE] Start rsync..." >> $LOG_FILE
160442.659: [16:04:42]
160442.659: [16:04:42]rsync -avz \
160442.659: [16:04:42]  --exclude '.git/' \
160442.659: [16:04:42]  --exclude 'tmp/**' \
160442.659: [16:04:42]  --partial --progress \
160442.659: [16:04:42]  -e 'ssh -p 22' \
160442.660: [16:04:42]  "${SRC_DIR}" "${DEST_USER}@${DEST_HOST}:${DEST_DIR}" >> $LOG_FILE 2>&1
160442.660: [16:04:42]
160442.660: [16:04:42]echo "[$DATE] Rsync finished." >> $LOG_FILE
160442.660: [16:04:42]echo "----------------------------------------" >> $LOG_FILE
