173027.776: [17:30:27]declare -A unique_ips
173027.776: [17:30:27]
173027.777: [17:30:27]# 解析函数：只取 A 记录，避免 IPv6 干扰；用进程替换避免子进程丢写
173027.777: [17:30:27]resolve_ipv4() {
173027.777: [17:30:27]  local d="$1"
173027.777: [17:30:27]  # +short 只输出 IP；指定 A 记录；加 +time=2 +tries=1 降低卡顿
173027.777: [17:30:27]  while read -r ip; do
173027.777: [17:30:27]    # 简单 IPv4 校验
173027.778: [17:30:27]    [[ "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || continue
173027.778: [17:30:27]    unique_ips["$ip"]=1
173027.778: [17:30:27]  done < <(dig +short +time=2 +tries=1 "$d" A 2>/dev/null)
173027.778: [17:30:27]}
173027.778: [17:30:27]
173027.778: [17:30:27]for domain in "${domains[@]}"; do
173027.778: [17:30:27]  echo "Resolving: $domain ..."
173027.778: [17:30:27]  resolve_ipv4 "$domain"
173027.778: [17:30:27]done
173027.778: [17:30:27]
173027.778: [17:30:27]# 保证 8.8.8.8 存在
173027.778: [17:30:27]unique_ips["8.8.8.8"]=1
173027.779: [17:30:27]unique_ips["112.4.0.55"]=1
173027.779: [17:30:27]unique_ips["120.232.153.120"]=1
173027.779: [17:30:27]unique_ips["103.45.234.158"]=1
173027.779: [17:30:27]
173027.779: [17:30:27]# 输出去重排序后的列表
173027.779: [17:30:27]output_file="ip_list.txt"
173027.779: [17:30:27]{
173027.779: [17:30:27]  for ip in "${!unique_ips[@]}"; do
173027.779: [17:30:27]    echo "$ip"
173027.779: [17:30:27]  done | sort -V
173027.779: [17:30:27]} > "$output_file"
173027.779: [17:30:27]
173027.780: [17:30:27]echo "✅ Saved to $output_file, total ${#unique_ips[@]} unique IPv4(s)."
173027.780: [17:30:27]
