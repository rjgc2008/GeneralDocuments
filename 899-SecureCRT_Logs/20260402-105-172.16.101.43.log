153556.923: [15:35:56]root@master:/tmp# vi 1.bash 
153556.967: [15:35:56]start_ip="192.168.8.0"
153556.967: [15:35:56]end_ip="192.168.11.255"
153556.967: [15:35:56]
153556.967: [15:35:56]# 将IP转为整数
153556.967: [15:35:56]ip2int() {
153556.967: [15:35:56]  local a b c d
153556.968: [15:35:56]  IFS=. read -r a b c d <<< "$1"
153556.968: [15:35:56]  echo $((a<<24 | b<<16 | c<<8 | d))
153556.968: [15:35:56]}
153556.968: [15:35:56]
153556.968: [15:35:56]# 将整数转回IP
153556.968: [15:35:56]int2ip() {
153556.969: [15:35:56]  local ip=$1
153556.970: [15:35:56]  echo "$(( (ip>>24)&255 )).$(( (ip>>16)&255 )).$(( (ip>>8)&255 )).$(( ip&255 ))"
153556.970: [15:35:56]}
153556.970: [15:35:56]
153556.970: [15:35:56]start=$(ip2int $start_ip)
153556.970: [15:35:56]end=$(ip2int $end_ip)
153556.970: [15:35:56]
153556.971: [15:35:56]for ((i=start; i<=end; i++)); do
153556.971: [15:35:56]  ip=$(int2ip $i)
153556.971: [15:35:56]  echo "Pinging $ip ..."
153556.971: [15:35:56]  ping -c 5 -W 1 $ip >/dev/null 2>&1
153556.971: [15:35:56]
153556.972: [15:35:56]  if [ $? -eq 0 ]; then
153556.978: [15:35:56]    echo "$ip is UP"
153556.978: [15:35:56]  else
153556.978: [15:35:56]    echo "$ip is DOWN"
153556.978: [15:35:56]  fi
153556.978: [15:35:56]done
