144436.397: [14:44:36]#!/bin/bash
144436.398: [14:44:36]# 功能：将 A 主机 /data/project/ 单向同步到 B 主机
144436.398: [14:44:36]# ============================================
144436.398: [14:44:36]
144436.398: [14:44:36]SRC_DIR="/DATA/xiaomi_camera_videos/"
144436.399: [14:44:36]DEST_USER="root"
144436.399: [14:44:36]DEST_HOST="10.253.0.2"
144436.399: [14:44:36]DEST_DIR="/DATA/Media/XTV-BACKUP/xiaomi_camera_videos/"
144436.399: [14:44:36]LOG_FILE="/var/log/rsync_project.log"
144436.400: [14:44:36]DATE=$(date '+%Y-%m-%d %H:%M:%S')
144436.400: [14:44:36]
144436.400: [14:44:36]echo "[$DATE] Start rsync..." >> $LOG_FILE
144436.400: [14:44:36]
144436.400: [14:44:36]rsync -avz \
144436.400: [14:44:36]  --exclude '.git/' \
144436.400: [14:44:36]  --exclude 'tmp/**' \
144436.400: [14:44:36]  --partial --progress \
144436.401: [14:44:36]  -e 'ssh -p 22' \
144436.401: [14:44:36]  "${SRC_DIR}" "${DEST_USER}@${DEST_HOST}:${DEST_DIR}" >> $LOG_FILE 2>&1
144436.401: [14:44:36]
144436.401: [14:44:36]echo "[$DATE] Rsync finished." >> $LOG_FILE
144436.401: [14:44:36]echo "----------------------------------------" >> $LOG_FILE
