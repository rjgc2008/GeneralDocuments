<mxfile host="app.diagrams.net">
  <diagram id="SNDS-NET" name="Network Architecture">
    <mxGraphModel dx="1217" dy="726" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ======================== -->
        <!-- Control Plane Group -->
        <!-- ======================== -->
        <mxCell id="control_plane" value="智能控制平面 (SNDS)" style="swimlane;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="300" height="260" as="geometry"/>
        </mxCell>

        <mxCell id="snds" value="SNDS 智能控制器" style="rounded=1;fillColor=#ff99ff;strokeColor=#333333;" vertex="1" parent="control_plane">
          <mxGeometry x="70" y="40" width="180" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="orch" value="全域资源编排" style="rounded=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="control_plane">
          <mxGeometry x="70" y="90" width="180" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="sec" value="内生安全治理" style="rounded=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="control_plane">
          <mxGeometry x="70" y="140" width="180" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="telemetry" value="INT 带内遥测分析" style="rounded=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="control_plane">
          <mxGeometry x="70" y="190" width="180" height="40" as="geometry"/>
        </mxCell>

        <!-- Control Plane edges -->
        <mxCell id="e1" edge="1" source="snds" target="orch" style="endArrow=block;"/>
        <mxCell id="e2" edge="1" source="snds" target="sec" style="endArrow=block;"/>
        <mxCell id="e3" edge="1" source="snds" target="telemetry" style="endArrow=block;"/>

        <!-- ======================== -->
        <!-- Backbone Group -->
        <!-- ======================== -->
        <mxCell id="interconnect" value="跨集群高速确定性骨干网" style="swimlane;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="380" y="40" width="420" height="260" as="geometry"/>
        </mxCell>

        <mxCell id="coreA" value="核心交换 A" style="rounded=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="interconnect">
          <mxGeometry x="40" y="60" width="120" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="coreB" value="核心交换 B" style="rounded=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="interconnect">
          <mxGeometry x="40" y="130" width="120" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="ocs" value="光路交换 (OCS)" style="rounded=1;fillColor=#ffffdd;strokeColor=#333333;" vertex="1" parent="interconnect">
          <mxGeometry x="200" y="95" width="140" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="dip" value="DIP/DetNet 广域网" style="rounded=1;fillColor=#bbbbff;strokeColor=#333333;" vertex="1" parent="interconnect">
          <mxGeometry x="360" y="95" width="140" height="40" as="geometry"/>
        </mxCell>

        <!-- Backbone edges -->
        <mxCell id="e4" edge="1" source="coreA" target="ocs" style="endArrow=diamond;startArrow=diamond;"/>
        <mxCell id="e5" edge="1" source="coreB" target="ocs" style="endArrow=diamond;startArrow=diamond;"/>
        <mxCell id="e6" edge="1" source="ocs" target="dip" style="endArrow=diamond;startArrow=diamond;"/>

        <!-- ======================== -->
        <!-- Cluster Layer -->
        <!-- ======================== -->
        <mxCell id="clusters" value="分布式算力集群层" style="swimlane;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="760" height="360" as="geometry"/>
        </mxCell>

        <!-- Cluster A -->
        <mxCell id="clusterA" value="核心集群 A (量子)" style="swimlane;" vertex="1" parent="clusters">
          <mxGeometry x="20" y="40" width="230" height="260" as="geometry"/>
        </mxCell>

        <mxCell id="leafA" value="边缘交换 A1" style="rounded=1;strokeColor=#333333;" vertex="1" parent="clusterA">
          <mxGeometry x="50" y="60" width="140" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="nicA" value="SmartNIC" style="rounded=1;" vertex="1" parent="clusterA">
          <mxGeometry x="50" y="120" width="140" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="qpuA" value="量子 QPU" style="rounded=1;" vertex="1" parent="clusterA">
          <mxGeometry x="50" y="180" width="140" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="e7" edge="1" source="nicA" target="qpuA" style="endArrow=none;dashed=1;"/>
        <mxCell id="e8" edge="1" source="nicA" target="leafA" style="endArrow=diamond;startArrow=diamond;"/>

        <!-- Cluster B -->
        <mxCell id="clusterB" value="核心集群 B (超算)" style="swimlane;" vertex="1" parent="clusters">
          <mxGeometry x="270" y="40" width="230" height="260" as="geometry"/>
        </mxCell>

        <mxCell id="leafB" value="边缘交换 B1" style="rounded=1;" vertex="1" parent="clusterB">
          <mxGeometry x="50" y="60" width="140" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="nicB" value="SmartNIC" style="rounded=1;" vertex="1" parent="clusterB">
          <mxGeometry x="50" y="120" width="140" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="gpuB" value="AI GPU" style="rounded=1;" vertex="1" parent="clusterB">
          <mxGeometry x="50" y="180" width="140" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="e9" edge="1" source="nicB" target="gpuB" style="endArrow=none;dashed=1;"/>
        <mxCell id="e10" edge="1" source="nicB" target="leafB" style="endArrow=diamond;startArrow=diamond;"/>

        <!-- Cluster C -->
        <mxCell id="clusterC" value="边缘集群 C (接入)" style="swimlane;" vertex="1" parent="clusters">
          <mxGeometry x="520" y="40" width="230" height="260" as="geometry"/>
        </mxCell>

        <mxCell id="leafC" value="边缘网关" style="rounded=1;" vertex="1" parent="clusterC">
          <mxGeometry x="50" y="60" width="140" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="nicC" value="SmartNIC" style="rounded=1;" vertex="1" parent="clusterC">
          <mxGeometry x="50" y="120" width="140" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="edgeDev" value="采集设备" style="rounded=1;" vertex="1" parent="clusterC">
          <mxGeometry x="50" y="180" width="140" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="e11" edge="1" source="nicC" target="edgeDev" style="endArrow=none;dashed=1;"/>
        <mxCell id="e12" edge="1" source="nicC" target="leafC" style="endArrow=diamond;startArrow=diamond;"/>

        <!-- Cluster ↔ Backbone edges -->
        <mxCell id="e13" edge="1" source="leafA" target="coreA" style="endArrow=diamond;startArrow=diamond;"/>
        <mxCell id="e14" edge="1" source="leafB" target="coreB" style="endArrow=diamond;startArrow=diamond;"/>
        <mxCell id="e15" edge="1" source="leafC" target="dip" style="endArrow=diamond;startArrow=diamond;"/>

        <!-- Control plane → other layers -->
        <mxCell id="e16" edge="1" source="control_plane" target="interconnect" style="dashed=1;endArrow=open;"/>
        <mxCell id="e17" edge="1" source="control_plane" target="clusters" style="dashed=1;endArrow=open;"/>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>